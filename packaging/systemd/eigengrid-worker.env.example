# Copy to /etc/eigengrid/worker.env and set site-owned values.
EIGENGRID_ROLE=worker
EIGENGRID_WORKER_SCRATCH_DIR=/var/lib/eigengrid/worker/scratch
EIGENGRID_NODE_NAME=worker-01
# Optional durable Head handoff; the file is local spool evidence, not a
# network trust boundary. A deployed site may replace the reporter sink.
# EIGENGRID_HEARTBEAT_FILE=/var/lib/eigengrid/worker/heartbeats.jsonl
# EIGENGRID_NODE_CAPABILITY_DIGEST=sha256:<measured-manifest-digest>

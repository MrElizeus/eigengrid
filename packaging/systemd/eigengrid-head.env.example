# Copy to /etc/eigengrid/head.env and set site-owned values.
EIGENGRID_ROLE=head
EIGENGRID_DEPLOYMENT_PROFILE=production
EIGENGRID_DB_PROVIDER=postgres
# This local peer DSN is not a password. It only works as the mapped Linux UID.
EIGENGRID_DATABASE_URL=postgresql://eigengrid_app@localhost/eigengrid?host=/run/postgresql
EIGENGRID_JOBS_DIR=/var/lib/eigengrid/head/jobs
EIGENGRID_LOGS_DIR=/var/lib/eigengrid/head/logs
EIGENGRID_OUTPUTS_DIR=/var/lib/eigengrid/head/outputs
EIGENGRID_SESSIONS_DIR=/var/lib/eigengrid/head/sessions
EIGENGRID_PYTHON=/usr/bin/python3
# The installer records the exact source commit, never a floating branch name.
# EIGENGRID_RELEASE_COMMIT=<40-character-git-commit>
# Dispatch remains disabled; a digest is not a substitute for gateway qualification.
# EIGENGRID_SCIENTIFIC_POLICY_DIGEST=<64-lowercase-hex-approved-policy-digest>

[Unit]
Description=EigenGrid Head (production admission closed pending qualification)
After=postgresql@16-main.service
Wants=postgresql@16-main.service
StartLimitIntervalSec=0

[Service]
Type=exec
User=eigengrid
Group=eigengrid
SupplementaryGroups=eigengrid-db
EnvironmentFile=/etc/eigengrid/head.env
StateDirectory=eigengrid/head
StateDirectoryMode=0700
WorkingDirectory=/var/lib/eigengrid/head
ExecStart=/opt/eigengrid/current/bin/eigengrid-head --dispatch-disabled --interval-ms 15000 --owner-id production-head
Restart=on-failure
RestartSec=15s
TimeoutStopSec=45s
KillMode=control-group
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/eigengrid/head
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProcSubset=pid
ProtectProc=invisible
DevicePolicy=closed
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
TasksMax=256
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%
Nice=10
# This site uses kernel peer authentication. No unused DB credential injection.
RestrictAddressFamilies=AF_UNIX
AppArmorProfile=eigengrid-head
LockPersonality=yes
# Qualified on Ubuntu 24.04 / Bun 1.3.14 against the real PostgreSQL socket.
Environment=BUN_JSC_useJIT=0
MemoryDenyWriteExecute=yes
UMask=0077

[Install]
WantedBy=multi-user.target

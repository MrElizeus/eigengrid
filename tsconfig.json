{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@eigengrid/core": ["./packages/core/src"],
      "@eigengrid/core/*": ["./packages/core/src/*"],
      "@eigengrid/protocol": ["./packages/protocol/src"],
      "@eigengrid/protocol/*": ["./packages/protocol/src/*"],
      "@eigengrid/config": ["./packages/config/src"],
      "@eigengrid/config/*": ["./packages/config/src/*"],
      "@eigengrid/db": ["./packages/db/src"],
      "@eigengrid/db/*": ["./packages/db/src/*"],
      "@eigengrid/events": ["./packages/events/src"],
      "@eigengrid/events/*": ["./packages/events/src/*"],
      "@eigengrid/runners": ["./packages/runners/src"],
      "@eigengrid/runners/*": ["./packages/runners/src/*"],
      "@eigengrid/python-bridge": ["./packages/python-bridge/src"],
      "@eigengrid/python-bridge/*": ["./packages/python-bridge/src/*"],
      "@eigengrid/tool-registry": ["./packages/tool-registry/src"],
      "@eigengrid/tool-registry/*": ["./packages/tool-registry/src/*"],
      "@eigengrid/model-gateway": ["./packages/model-gateway/src"],
      "@eigengrid/model-gateway/*": ["./packages/model-gateway/src/*"],
      "@eigengrid/agent-runtime": ["./packages/agent-runtime/src"],
      "@eigengrid/agent-runtime/*": ["./packages/agent-runtime/src/*"],
      "@eigengrid/agent": ["./packages/agent/src"],
      "@eigengrid/agent/*": ["./packages/agent/src/*"],
      "@eigengrid/recipes": ["./packages/recipes/src"],
      "@eigengrid/recipes/*": ["./packages/recipes/src/*"],
      "@eigengrid/worker": ["./packages/worker/src"],
      "@eigengrid/worker/*": ["./packages/worker/src/*"],
      "@eigengrid/worker-agent": ["./packages/worker-agent/src"],
      "@eigengrid/worker-agent/*": ["./packages/worker-agent/src/*"],
      "@eigengrid/scheduler": ["./packages/scheduler/src"],
      "@eigengrid/scheduler/*": ["./packages/scheduler/src/*"],
      "@eigengrid/slurm": ["./packages/slurm/src"],
      "@eigengrid/slurm/*": ["./packages/slurm/src/*"],
      "@eigengrid/backup": ["./packages/backup/src"],
      "@eigengrid/backup/*": ["./packages/backup/src/*"],
      "@eigengrid/scientific-schema": ["./packages/scientific-schema/src"],
      "@eigengrid/scientific-schema/*": ["./packages/scientific-schema/src/*"],
      "@eigengrid/mission-runtime": ["./packages/mission-runtime/src"],
      "@eigengrid/mission-runtime/*": ["./packages/mission-runtime/src/*"],
      "@eigengrid/scientific-skills": ["./packages/scientific-skills/src"],
      "@eigengrid/scientific-skills/*": ["./packages/scientific-skills/src/*"],
      "@eigengrid/scientific-agent": ["./packages/scientific-agent/src"],
      "@eigengrid/scientific-agent/*": ["./packages/scientific-agent/src/*"],
      "@eigengrid/amber-adapter": ["./packages/amber-adapter/src"],
      "@eigengrid/amber-adapter/*": ["./packages/amber-adapter/src/*"],
      "@eigengrid/biomolecular-prep": ["./packages/biomolecular-prep/src"],
      "@eigengrid/biomolecular-prep/*": ["./packages/biomolecular-prep/src/*"],
      "@eigengrid/md-analysis": ["./packages/md-analysis/src"],
      "@eigengrid/agent-substrate": ["./packages/agent-substrate/src"],
      "@eigengrid/agent-substrate/*": ["./packages/agent-substrate/src/*"],
      "@eigengrid/colony-contracts": ["./packages/colony-contracts/src"],
      "@eigengrid/colony-contracts/*": ["./packages/colony-contracts/src/*"],
      "@eigengrid/colony-runtime": ["./packages/colony-runtime/src"],
      "@eigengrid/colony-runtime/*": ["./packages/colony-runtime/src/*"],
      "@eigengrid/effect-journal": ["./packages/effect-journal/src"],
      "@eigengrid/effect-journal/*": ["./packages/effect-journal/src/*"],
      "@eigengrid/myrmex-profile": ["./packages/myrmex-profile/src"],
      "@eigengrid/myrmex-profile/*": ["./packages/myrmex-profile/src/*"],
      "@eigengrid/md-analysis/*": ["./packages/md-analysis/src/*"],
      "@eigengrid/protocol-core": ["./packages/protocol-core/src"],
      "@eigengrid/protocol-core/*": ["./packages/protocol-core/src/*"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "apps/*/bin/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx"
  ]
}

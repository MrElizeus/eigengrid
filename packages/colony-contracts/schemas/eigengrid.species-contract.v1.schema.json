{
  "$ref": "#/definitions/eigengrid.species-contract.v1",
  "definitions": {
    "eigengrid.species-contract.v1": {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "const": "eigengrid.species-contract.v1" },
        "identity": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 16,
              "maxLength": 180,
              "pattern": "^eigengrid\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/v[1-9]\\d*$"
            },
            "version": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            }
          },
          "required": ["id", "version"],
          "additionalProperties": false
        },
        "genus": {
          "type": "string",
          "enum": [
            "architecture",
            "software-engineering",
            "release",
            "infrastructure",
            "provisioning",
            "incident-response",
            "scientific-planning",
            "scientific-execution",
            "scientific-diagnosis",
            "scientific-validation",
            "research",
            "knowledge-curation"
          ]
        },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 200 }
        },
        "objectiveSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
            },
            "version": {
              "$ref": "#/definitions/eigengrid.species-contract.v1/properties/identity/properties/version"
            },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "required": ["id", "version", "digest"],
          "additionalProperties": false
        },
        "castes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "governor",
                  "architect",
                  "scout",
                  "forager",
                  "builder",
                  "operator",
                  "critic",
                  "verifier",
                  "sentinel",
                  "steward",
                  "medic",
                  "integrator"
                ]
              },
              "required": { "type": "boolean" },
              "maxInstances": { "type": "integer", "exclusiveMinimum": 0 },
              "responsibilities": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
                "minItems": 1
              },
              "allowedCapabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 160,
                  "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
                }
              },
              "prohibitedCapabilities": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
                },
                "minItems": 1
              },
              "stateReadScopes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
              },
              "candidateWriteScopes": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
              },
              "allowedModelTiers": {
                "type": "array",
                "items": { "type": "string", "enum": ["T0", "T1", "T2", "T3", "T4"] },
                "minItems": 1
              },
              "providerPolicyIds": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
                }
              },
              "contextSchema": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/objectiveSchema"
              },
              "resultSchema": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/objectiveSchema"
              },
              "ownership": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
              },
              "verificationDuties": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
              },
              "mayDelegate": { "type": "boolean" },
              "maximumChildDepth": { "type": "integer", "minimum": 0 }
            },
            "required": [
              "id",
              "required",
              "maxInstances",
              "responsibilities",
              "allowedCapabilities",
              "prohibitedCapabilities",
              "stateReadScopes",
              "candidateWriteScopes",
              "allowedModelTiers",
              "providerPolicyIds",
              "contextSchema",
              "resultSchema",
              "ownership",
              "verificationDuties",
              "mayDelegate",
              "maximumChildDepth"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "ownershipBoundaries": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
          "minItems": 1
        },
        "capabilityAllowlist": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
          }
        },
        "authority": {
          "type": "object",
          "properties": {
            "stateReadScopes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "candidateWriteScopes": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
            },
            "explicitlyProhibited": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 2048 },
              "minItems": 1
            }
          },
          "required": ["stateReadScopes", "candidateWriteScopes", "explicitlyProhibited"],
          "additionalProperties": false
        },
        "contextPolicy": {
          "type": "object",
          "properties": {
            "maximumBytes": { "type": "integer", "exclusiveMinimum": 0 },
            "allowedTrustClasses": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "authoritative_state",
                  "validated_skill",
                  "external_evidence",
                  "model_hypothesis",
                  "untrusted_retrieved_text"
                ]
              }
            },
            "sensitiveExclusionsRequired": { "type": "boolean" }
          },
          "required": ["maximumBytes", "allowedTrustClasses", "sensitiveExclusionsRequired"],
          "additionalProperties": false
        },
        "memoryPolicy": {
          "type": "object",
          "properties": {
            "readableScopes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              }
            },
            "candidateWriteAllowed": { "type": "boolean" },
            "directPromotionAllowed": { "type": "boolean", "const": false }
          },
          "required": ["readableScopes", "candidateWriteAllowed", "directPromotionAllowed"],
          "additionalProperties": false
        },
        "skillPolicy": {
          "type": "object",
          "properties": {
            "requiredSkillIds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              }
            },
            "candidateWriteAllowed": { "type": "boolean" },
            "directPromotionAllowed": { "type": "boolean", "const": false }
          },
          "required": ["requiredSkillIds", "candidateWriteAllowed", "directPromotionAllowed"],
          "additionalProperties": false
        },
        "evidencePolicy": {
          "type": "object",
          "properties": {
            "requiredKinds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              }
            },
            "contentDigestsRequired": { "type": "boolean" },
            "independentEvidenceRequired": { "type": "boolean" }
          },
          "required": ["requiredKinds", "contentDigestsRequired", "independentEvidenceRequired"],
          "additionalProperties": false
        },
        "budgetPolicy": {
          "type": "object",
          "properties": {
            "wallTimeMs": { "type": "integer", "exclusiveMinimum": 0 },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "costMicrounits": { "type": "integer", "minimum": 0 },
            "effects": { "type": "integer", "minimum": 0 },
            "corrections": { "type": "integer", "minimum": 0 },
            "modelCalls": { "type": "integer", "minimum": 0 },
            "computeSeconds": { "type": "integer", "minimum": 0 },
            "storageBytes": { "type": "integer", "minimum": 0 },
            "networkBytes": { "type": "integer", "minimum": 0 },
            "deadline": { "type": "string", "format": "date-time" }
          },
          "required": [
            "wallTimeMs",
            "inputTokens",
            "outputTokens",
            "costMicrounits",
            "effects",
            "corrections",
            "modelCalls",
            "computeSeconds",
            "storageBytes",
            "networkBytes"
          ],
          "additionalProperties": false
        },
        "approvalPolicy": {
          "type": "object",
          "properties": {
            "maximumAutonomy": { "type": "string", "enum": ["A0", "A1", "A2", "A3", "A4"] },
            "approvalRequiredAtOrAboveRisk": {
              "type": "string",
              "enum": ["R0", "R1", "R2", "R3", "R4", "R5"]
            },
            "exactSubjectBindingRequired": { "type": "boolean", "const": true }
          },
          "required": [
            "maximumAutonomy",
            "approvalRequiredAtOrAboveRisk",
            "exactSubjectBindingRequired"
          ],
          "additionalProperties": false
        },
        "riskCeiling": {
          "$ref": "#/definitions/eigengrid.species-contract.v1/properties/approvalPolicy/properties/approvalRequiredAtOrAboveRisk"
        },
        "verificationTopology": {
          "type": "object",
          "properties": {
            "independent": { "type": "boolean" },
            "requiredVerifierCastes": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/id"
              }
            },
            "deterministicChecks": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              }
            },
            "requiredEvidenceKinds": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              }
            },
            "acceptedVerdicts": {
              "type": "array",
              "items": { "type": "string", "enum": ["pass", "fail", "blocked", "inconclusive"] },
              "minItems": 1
            }
          },
          "required": [
            "independent",
            "requiredVerifierCastes",
            "deterministicChecks",
            "requiredEvidenceKinds",
            "acceptedVerdicts"
          ],
          "additionalProperties": false
        },
        "correctionTopology": {
          "type": "object",
          "properties": {
            "maximumCorrections": { "type": "integer", "minimum": 0 },
            "measurableProgressRequired": { "type": "boolean", "const": true },
            "preservedSuccessRequired": { "type": "boolean", "const": true },
            "independentReverificationRequired": { "type": "boolean" }
          },
          "required": [
            "maximumCorrections",
            "measurableProgressRequired",
            "preservedSuccessRequired",
            "independentReverificationRequired"
          ],
          "additionalProperties": false
        },
        "frontierEscalation": {
          "type": "object",
          "properties": {
            "maximumCalls": { "type": "integer", "minimum": 0 },
            "triggers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "architectural_lock_in",
                  "novel_scientific_decision",
                  "critic_disagreement",
                  "repeated_non_progress",
                  "objective_change",
                  "material_protocol_choice",
                  "compatibility_risk",
                  "production_qualification"
                ]
              }
            },
            "effectCapabilities": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
              },
              "minItems": 0,
              "maxItems": 0
            }
          },
          "required": ["maximumCalls", "triggers", "effectCapabilities"],
          "additionalProperties": false
        },
        "terminationConditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "minItems": 1
        },
        "failureSemantics": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 4096 },
          "minItems": 1
        },
        "supportedAutonomyLevels": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.species-contract.v1/properties/approvalPolicy/properties/maximumAutonomy"
          },
          "minItems": 1
        },
        "compatibility": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "protocol",
                  "contract",
                  "species_schema",
                  "skill_schema",
                  "artifact_evidence_schema",
                  "database_schema",
                  "eigengrid",
                  "codex_substrate",
                  "myrmex_profile"
                ]
              },
              "id": {
                "$ref": "#/definitions/eigengrid.species-contract.v1/properties/objectiveSchema/properties/id"
              },
              "range": {
                "type": "object",
                "properties": {
                  "minimumInclusive": {
                    "$ref": "#/definitions/eigengrid.species-contract.v1/properties/identity/properties/version"
                  },
                  "maximumExclusive": {
                    "$ref": "#/definitions/eigengrid.species-contract.v1/properties/identity/properties/version"
                  }
                },
                "required": ["minimumInclusive", "maximumExclusive"],
                "additionalProperties": false
              },
              "requiredFeatureFlags": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
                }
              }
            },
            "required": ["kind", "id", "range", "requiredFeatureFlags"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "evaluationSuiteIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.species-contract.v1/properties/castes/items/properties/allowedCapabilities/items"
          },
          "minItems": 1
        },
        "promotionStatus": {
          "type": "string",
          "enum": [
            "unqualified",
            "shadow",
            "canary",
            "qualified",
            "preferred",
            "degraded",
            "quarantined",
            "retired"
          ]
        },
        "contractDigest": {
          "$ref": "#/definitions/eigengrid.species-contract.v1/properties/objectiveSchema/properties/digest"
        }
      },
      "required": [
        "schema",
        "identity",
        "genus",
        "displayName",
        "aliases",
        "objectiveSchema",
        "castes",
        "ownershipBoundaries",
        "capabilityAllowlist",
        "authority",
        "contextPolicy",
        "memoryPolicy",
        "skillPolicy",
        "evidencePolicy",
        "budgetPolicy",
        "approvalPolicy",
        "riskCeiling",
        "verificationTopology",
        "correctionTopology",
        "frontierEscalation",
        "terminationConditions",
        "failureSemantics",
        "supportedAutonomyLevels",
        "compatibility",
        "evaluationSuiteIds",
        "promotionStatus",
        "contractDigest"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigengrid.dev/schemas/colony/eigengrid.species-contract.v1.schema.json",
  "title": "eigengrid.species-contract.v1 runtime contract"
}

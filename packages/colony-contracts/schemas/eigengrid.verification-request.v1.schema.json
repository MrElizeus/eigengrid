{
  "$ref": "#/definitions/eigengrid.verification-request.v1",
  "definitions": {
    "eigengrid.verification-request.v1": {
      "type": "object",
      "properties": {
        "schema": { "type": "string", "const": "eigengrid.verification-request.v1" },
        "verificationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@+-]*$"
        },
        "requestId": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
        },
        "correlationId": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
        },
        "causationId": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
        },
        "workOrderId": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
        },
        "workResultDigest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "candidate": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
            },
            "kind": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            },
            "digest": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/workResultDigest"
            },
            "trustClass": { "type": "string", "const": "model_hypothesis" },
            "uri": { "type": "string", "minLength": 1, "maxLength": 2048 },
            "claim": { "type": "string", "minLength": 1, "maxLength": 16384 },
            "accessedAt": { "type": "string", "format": "date-time" }
          },
          "required": ["id", "kind", "digest", "trustClass"],
          "additionalProperties": false
        },
        "expectedBaseIdentity": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["repository", "mission", "operation", "artifact"]
            },
            "id": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
            },
            "revision": {
              "anyOf": [
                { "type": "integer", "minimum": 0 },
                { "type": "string", "minLength": 1, "maxLength": 256 }
              ]
            },
            "digest": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/workResultDigest"
            }
          },
          "required": ["kind", "id", "revision", "digest"],
          "additionalProperties": false
        },
        "species": {
          "type": "object",
          "properties": {
            "schema": { "type": "string", "const": "eigengrid.species-identity.v1" },
            "coordinate": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 16,
                  "maxLength": 180,
                  "pattern": "^eigengrid\\.[a-z0-9]+(?:-[a-z0-9]+)*\\/v[1-9]\\d*$"
                },
                "version": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
                }
              },
              "required": ["id", "version"],
              "additionalProperties": false
            },
            "contractDigest": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/workResultDigest"
            }
          },
          "required": ["schema", "coordinate", "contractDigest"],
          "additionalProperties": false
        },
        "verifierCaste": {
          "type": "string",
          "enum": [
            "governor",
            "architect",
            "scout",
            "forager",
            "builder",
            "operator",
            "critic",
            "verifier",
            "sentinel",
            "steward",
            "medic",
            "integrator"
          ]
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
              },
              "statement": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "verification": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "scientificallyMaterial": { "type": "boolean" }
            },
            "required": ["id", "statement", "verification", "scientificallyMaterial"],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "protectedState": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
              },
              "kind": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/kind"
              },
              "digest": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/workResultDigest"
              },
              "trustClass": {
                "type": "string",
                "enum": [
                  "authoritative_state",
                  "validated_skill",
                  "external_evidence",
                  "model_hypothesis",
                  "untrusted_retrieved_text"
                ]
              },
              "uri": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/uri"
              },
              "claim": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/claim"
              },
              "accessedAt": {
                "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/accessedAt"
              }
            },
            "required": ["id", "kind", "digest", "trustClass"],
            "additionalProperties": false
          }
        },
        "requiredEvidenceIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
          }
        },
        "writerInvocationId": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/verificationId"
        },
        "independence": {
          "type": "object",
          "properties": {
            "differentInvocationRequired": { "type": "boolean", "const": true },
            "writerPrivateReasoningExcluded": { "type": "boolean", "const": true },
            "candidateWriteProhibited": { "type": "boolean", "const": true }
          },
          "required": [
            "differentInvocationRequired",
            "writerPrivateReasoningExcluded",
            "candidateWriteProhibited"
          ],
          "additionalProperties": false
        },
        "allowedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/kind"
          }
        },
        "prohibitedCapabilities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/kind"
          }
        },
        "budget": {
          "type": "object",
          "properties": {
            "wallTimeMs": { "type": "integer", "exclusiveMinimum": 0 },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "costMicrounits": { "type": "integer", "minimum": 0 },
            "effects": { "type": "number", "const": 0 },
            "corrections": { "type": "integer", "minimum": 0 },
            "modelCalls": { "type": "integer", "minimum": 0 },
            "computeSeconds": { "type": "integer", "minimum": 0 },
            "storageBytes": { "type": "integer", "minimum": 0 },
            "networkBytes": { "type": "integer", "minimum": 0 },
            "deadline": {
              "$ref": "#/definitions/eigengrid.verification-request.v1/properties/candidate/properties/accessedAt"
            }
          },
          "required": [
            "wallTimeMs",
            "inputTokens",
            "outputTokens",
            "costMicrounits",
            "effects",
            "corrections",
            "modelCalls",
            "computeSeconds",
            "storageBytes",
            "networkBytes"
          ],
          "additionalProperties": false
        },
        "requestDigest": {
          "$ref": "#/definitions/eigengrid.verification-request.v1/properties/workResultDigest"
        }
      },
      "required": [
        "schema",
        "verificationId",
        "requestId",
        "correlationId",
        "causationId",
        "workOrderId",
        "workResultDigest",
        "candidate",
        "expectedBaseIdentity",
        "species",
        "verifierCaste",
        "acceptanceCriteria",
        "protectedState",
        "requiredEvidenceIds",
        "writerInvocationId",
        "independence",
        "allowedCapabilities",
        "prohibitedCapabilities",
        "budget",
        "requestDigest"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eigengrid.dev/schemas/colony/eigengrid.verification-request.v1.schema.json",
  "title": "eigengrid.verification-request.v1 runtime contract"
}

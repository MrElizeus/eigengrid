# Replace the hostname with the DNS name pointing to this host.
# Match 4317 to the port in protected mission-client.json.
# Keep Bun on loopback. Caddy terminates TLS and forwards the original Host.
grid.example.org {
    encode zstd gzip
    reverse_proxy 127.0.0.1:4317 {
        flush_interval -1
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
